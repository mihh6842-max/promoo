# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_telegram_user_id

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/promo_bot.db

# Redis (опционально)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Parser Settings
PARSER_ENABLED=true
PARSER_SCHEDULE=0 */6 * * *
PARSER_MAX_RETRIES=3
PARSER_TIMEOUT=300
PARSER_URL=https://cuponcod.ru
PARSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Логирование
LOG_LEVEL=INFO
